{
  "$schema": "../schema/kind-profile.schema.json",
  "type": "FabricationKindProfile",
  "version": 1,
  "kind": "newsletter-issue",
  "title": "Newsletter issue",
  "summary": "One newsletter issue as the platform-neutral issue record with its Markdown and paste-ready HTML renderings, validated and re-rendered by the email-newsletter section.",
  "delegate": {
    "package": "@red-cup-engineering/email-newsletter-engineering-services-section",
    "fabricate": "compose-issue",
    "accept": "newsletter-issue#validateIssue"
  },
  "inputSchema": {
    "type": "object",
    "required": [
      "title",
      "brief"
    ],
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "brief": {
        "type": "string",
        "minLength": 1
      },
      "audience": {
        "type": "string"
      },
      "sections": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "producers": [
    {
      "id": "agent",
      "package": "@red-cup-engineering/agent-harness-computer-system-engineering-services-section",
      "operation": "carrier/agency-carrier",
      "role": "Writes the issue sections and references to the brief.",
      "source": "agent-harness"
    },
    {
      "id": "newsletter",
      "package": "@red-cup-engineering/email-newsletter-engineering-services-section",
      "operation": "validateIssue, renderMarkdown, renderPasteHtml",
      "role": "Validates the issue and renders it.",
      "source": "registry"
    }
  ],
  "steps": [
    {
      "id": "write-issue",
      "producer": "agent",
      "summary": "Write the issue record: dek, sections and CSL references.",
      "consumes": [
        "order"
      ],
      "produces": [
        "issue-record"
      ],
      "dependsOn": []
    },
    {
      "id": "render-issue",
      "producer": "newsletter",
      "summary": "Validate the issue and render Markdown and paste-ready HTML.",
      "consumes": [
        "issue-record"
      ],
      "produces": [
        "issue",
        "markdown",
        "html"
      ],
      "dependsOn": [
        "write-issue"
      ]
    }
  ],
  "deliverables": [
    {
      "projection": "issue",
      "mediaType": "application/json",
      "target": "issue.json"
    },
    {
      "projection": "markdown",
      "mediaType": "text/markdown",
      "target": "issue.md"
    },
    {
      "projection": "html",
      "mediaType": "text/html",
      "target": "issue.html"
    }
  ],
  "assays": [
    {
      "id": "issue-valid",
      "statement": "The issue record validates: shape, sections and every cited key resolved in the references.",
      "uses": [
        "@red-cup-engineering/email-newsletter-engineering-services-section"
      ]
    },
    {
      "id": "renderings-reproduce",
      "statement": "Rendering the delivered issue record again yields exactly the delivered Markdown and HTML bytes.",
      "uses": [
        "@red-cup-engineering/email-newsletter-engineering-services-section"
      ]
    }
  ],
  "price": {
    "currency": "USD",
    "basis": "fixed",
    "amount": "$25.00"
  },
  "turnaround": {
    "seconds": 86400,
    "label": "within 24 hours of an activated order"
  },
  "constraints": [
    {
      "id": "content-address-identity",
      "kind": "law",
      "authority": "IETF RFC 6920",
      "revision": "2013",
      "locator": "https://www.rfc-editor.org/rfc/rfc6920",
      "applicability": "Every delivered byte string.",
      "statement": "A delivered artifact is named by the sha-256 ni name of its bytes; equal bytes have equal names, so acceptance is evidence about those bytes alone."
    },
    {
      "id": "newsletter-issue-shape",
      "kind": "standard",
      "authority": "561 Group email-newsletter-engineering-services-section",
      "revision": "0.1.1",
      "locator": "@red-cup-engineering/email-newsletter-engineering-services-section",
      "applicability": "The issue record.",
      "statement": "An issue is the platform-neutral record the newsletter section validates, and every rendering is its deterministic projection."
    },
    {
      "id": "signcell-acceptance",
      "kind": "standard",
      "authority": "561 Group SignCell",
      "revision": "0.12",
      "locator": "@red-cup-engineering/signcell/cell",
      "applicability": "Acceptance.",
      "statement": "Acceptance is a SignCell cell per assay: subject the artifact ni, predicate the assay id, witnesses the assay evidence."
    }
  ],
  "requirements": [
    {
      "id": "issue-delivered",
      "statement": "Deliver the issue whose title the order states as an issue record with Markdown and HTML renderings.",
      "constraints": [
        "newsletter-issue-shape",
        "content-address-identity"
      ],
      "projections": [
        "issue",
        "markdown",
        "html"
      ],
      "acceptance": [
        "issue-valid",
        "renderings-reproduce"
      ]
    }
  ],
  "prohibitions": [
    {
      "id": "no-unresolved-citation",
      "statement": "No section may cite a key the references do not carry.",
      "constraints": [
        "newsletter-issue-shape"
      ],
      "projections": [
        "issue"
      ],
      "acceptance": [
        "issue-valid"
      ]
    }
  ]
}
