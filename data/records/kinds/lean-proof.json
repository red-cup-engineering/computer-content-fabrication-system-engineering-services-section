{
  "$schema": "../schema/kind-profile.schema.json",
  "type": "FabricationKindProfile",
  "version": 1,
  "kind": "lean-proof",
  "title": "Lean 4 proof",
  "summary": "A Lean 4 theorem statement proved and checked clean by lean-check: a successful compile, the stated declaration unchanged, and no axiom beyond the allowed set.",
  "inputSchema": {
    "type": "object",
    "required": [
      "statement",
      "theoremName",
      "module",
      "tier"
    ],
    "additionalProperties": false,
    "properties": {
      "statement": {
        "type": "string",
        "minLength": 1,
        "description": "The Lean 4 theorem statement, from `theorem` through its type, before `:=`."
      },
      "theoremName": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*$"
      },
      "module": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)*$"
      },
      "imports": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "Mathlib"
        ]
      },
      "tier": {
        "enum": [
          "routine",
          "standard",
          "advanced"
        ],
        "description": "The declared difficulty tier; it sets price and turnaround."
      },
      "allowedAxioms": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "propext",
          "Classical.choice",
          "Quot.sound"
        ]
      }
    }
  },
  "producers": [
    {
      "id": "agent",
      "package": "@red-cup-engineering/agent-harness-computer-system-engineering-services-section",
      "operation": "carrier/agency-carrier",
      "role": "Searches for and writes the proof of the stated theorem.",
      "source": "agent-harness"
    },
    {
      "id": "lean-check",
      "package": "@red-cup-engineering/lean-system-services-section",
      "operation": "check/plan planLeanCheck + check/run runLeanCheck",
      "role": "Builds the proof inside the lean scope and inspects the declaration's axioms.",
      "source": "registry"
    }
  ],
  "steps": [
    {
      "id": "search-proof",
      "producer": "agent",
      "summary": "Write a proof of the stated theorem as a Lean module.",
      "consumes": [
        "order"
      ],
      "produces": [
        "proof-source"
      ],
      "dependsOn": []
    },
    {
      "id": "check-proof",
      "producer": "lean-check",
      "summary": "Build the module and inspect the declaration's axioms.",
      "consumes": [
        "proof-source"
      ],
      "produces": [
        "proof",
        "check"
      ],
      "dependsOn": [
        "search-proof"
      ]
    }
  ],
  "deliverables": [
    {
      "projection": "proof",
      "mediaType": "text/x-lean4",
      "target": "Proof.lean"
    },
    {
      "projection": "check",
      "mediaType": "application/json",
      "target": "lean-check.json"
    }
  ],
  "assays": [
    {
      "id": "lean-check-clean",
      "statement": "lean-check of the module succeeded: exit zero, no compiler error, output complete, scope cleared, source unchanged.",
      "uses": [
        "@red-cup-engineering/lean-system-services-section"
      ]
    },
    {
      "id": "statement-unchanged",
      "statement": "The delivered module states exactly the ordered theorem statement under the ordered name.",
      "uses": []
    },
    {
      "id": "axioms-allowed",
      "statement": "The declaration depends on no axiom outside the allowed set and not on sorryAx.",
      "uses": [
        "@red-cup-engineering/lean-system-services-section"
      ]
    }
  ],
  "price": {
    "currency": "USD",
    "basis": "tier",
    "tierField": "tier",
    "tiers": {
      "routine": "$20.00",
      "standard": "$60.00",
      "advanced": "$200.00"
    }
  },
  "turnaround": {
    "seconds": 43200,
    "tiers": {
      "routine": 7200,
      "standard": 43200,
      "advanced": 259200
    },
    "label": "by declared tier: 2 hours, 12 hours or 72 hours from an activated order"
  },
  "constraints": [
    {
      "id": "content-address-identity",
      "kind": "law",
      "authority": "IETF RFC 6920",
      "revision": "2013",
      "locator": "https://www.rfc-editor.org/rfc/rfc6920",
      "applicability": "Every delivered byte string.",
      "statement": "A delivered artifact is named by the sha-256 ni name of its bytes; equal bytes have equal names, so acceptance is evidence about those bytes alone."
    },
    {
      "id": "lean-kernel-soundness",
      "kind": "law",
      "authority": "Lean 4 kernel",
      "revision": "the toolchain pinned by the order's project",
      "locator": "https://lean-lang.org/",
      "applicability": "The proof module.",
      "statement": "A theorem is proved only when the Lean kernel accepts its declaration without sorry and without an axiom beyond those allowed."
    },
    {
      "id": "lean-check-admission",
      "kind": "standard",
      "authority": "561 Group lean-system-services-section",
      "revision": "0.2.2",
      "locator": "@red-cup-engineering/lean-system-services-section/check/admission",
      "applicability": "The check deliverable.",
      "statement": "A check succeeds only when exit zero, no compiler error, complete output, a cleared scope and unchanged source all hold."
    },
    {
      "id": "signcell-acceptance",
      "kind": "standard",
      "authority": "561 Group SignCell",
      "revision": "0.12",
      "locator": "@red-cup-engineering/signcell/cell",
      "applicability": "Acceptance.",
      "statement": "Acceptance is a SignCell cell per assay: subject the artifact ni, predicate the assay id, witnesses the assay evidence."
    }
  ],
  "requirements": [
    {
      "id": "proof-delivered",
      "statement": "Deliver a Lean module proving the theorem the order names, exactly as the order states it.",
      "constraints": [
        "lean-kernel-soundness",
        "content-address-identity"
      ],
      "projections": [
        "proof"
      ],
      "acceptance": [
        "statement-unchanged",
        "axioms-allowed"
      ]
    },
    {
      "id": "check-delivered",
      "statement": "Deliver the clean lean-check result for the module the order names.",
      "constraints": [
        "lean-check-admission",
        "signcell-acceptance"
      ],
      "projections": [
        "check"
      ],
      "acceptance": [
        "lean-check-clean"
      ]
    }
  ],
  "prohibitions": [
    {
      "id": "no-sorry",
      "statement": "The proof may not contain sorry or depend on sorryAx.",
      "constraints": [
        "lean-kernel-soundness"
      ],
      "projections": [
        "proof"
      ],
      "acceptance": [
        "axioms-allowed",
        "lean-check-clean"
      ]
    }
  ]
}
