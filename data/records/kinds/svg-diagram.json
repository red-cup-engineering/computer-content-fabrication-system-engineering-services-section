{
  "$schema": "../schema/kind-profile.schema.json",
  "type": "FabricationKindProfile",
  "version": 1,
  "kind": "svg-diagram",
  "title": "SVG diagram",
  "summary": "A diagram as SVG exported from a dependency graph, a symbol graph or a Lean blueprint, covering every node of the graph.",
  "inputSchema": {
    "type": "object",
    "required": [
      "intent",
      "source"
    ],
    "additionalProperties": false,
    "properties": {
      "intent": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "type": "object",
        "required": [
          "kind",
          "graph"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "dependency-graph",
              "symbol-graph",
              "lean-blueprint"
            ]
          },
          "graph": {
            "type": "object",
            "description": "The graph to draw: nodes (id, label) and edges (from, to)."
          }
        }
      }
    }
  },
  "producers": [
    {
      "id": "agent",
      "package": "@red-cup-engineering/agent-harness-computer-system-engineering-services-section",
      "operation": "carrier/agency-carrier",
      "role": "Shapes the graph from the buyer's intent when the graph is incomplete.",
      "source": "agent-harness"
    },
    {
      "id": "workspace-svg",
      "package": "@red-cup-engineering/computer-systems-fabrication-engineering-services-section",
      "operation": "analysis/workspace/svg dependencyGraphSvg; analysis/workspace/symbol-svg symbolGraphSvg",
      "role": "Lays out and draws dependency and symbol graphs as SVG.",
      "source": "registry"
    },
    {
      "id": "blueprint",
      "package": "@red-cup-engineering/lean-blueprint-chart-service",
      "operation": "render-lean-blueprint-chart",
      "role": "Draws a Lean blueprint as an SVG chart.",
      "source": "github"
    }
  ],
  "steps": [
    {
      "id": "shape-graph",
      "producer": "agent",
      "summary": "Complete the graph from the buyer's intent.",
      "consumes": [
        "order"
      ],
      "produces": [
        "graph"
      ],
      "dependsOn": []
    },
    {
      "id": "draw-diagram",
      "producer": "workspace-svg",
      "summary": "Lay out and draw the graph as SVG (blueprints through the blueprint chart service).",
      "consumes": [
        "graph"
      ],
      "produces": [
        "svg"
      ],
      "dependsOn": [
        "shape-graph"
      ]
    }
  ],
  "deliverables": [
    {
      "projection": "svg",
      "mediaType": "image/svg+xml",
      "target": "diagram.svg"
    },
    {
      "projection": "graph",
      "mediaType": "application/json",
      "target": "diagram.graph.json"
    }
  ],
  "assays": [
    {
      "id": "svg-safe",
      "statement": "The SVG has an svg root and carries no script, event handler, foreignObject or external reference.",
      "uses": []
    },
    {
      "id": "svg-covers-graph",
      "statement": "Every node of the delivered graph is labelled in the SVG.",
      "uses": []
    }
  ],
  "price": {
    "currency": "USD",
    "basis": "fixed",
    "amount": "$10.00"
  },
  "turnaround": {
    "seconds": 1800,
    "label": "within 30 minutes of an activated order"
  },
  "constraints": [
    {
      "id": "content-address-identity",
      "kind": "law",
      "authority": "IETF RFC 6920",
      "revision": "2013",
      "locator": "https://www.rfc-editor.org/rfc/rfc6920",
      "applicability": "Every delivered byte string.",
      "statement": "A delivered artifact is named by the sha-256 ni name of its bytes; equal bytes have equal names, so acceptance is evidence about those bytes alone."
    },
    {
      "id": "svg-1-1",
      "kind": "standard",
      "authority": "W3C",
      "revision": "Scalable Vector Graphics (SVG) 1.1 (Second Edition)",
      "locator": "https://www.w3.org/TR/SVG11/",
      "applicability": "The SVG deliverable.",
      "statement": "The deliverable is a well-formed SVG document."
    },
    {
      "id": "signcell-acceptance",
      "kind": "standard",
      "authority": "561 Group SignCell",
      "revision": "0.12",
      "locator": "@red-cup-engineering/signcell/cell",
      "applicability": "Acceptance.",
      "statement": "Acceptance is a SignCell cell per assay: subject the artifact ni, predicate the assay id, witnesses the assay evidence."
    }
  ],
  "requirements": [
    {
      "id": "diagram-delivered",
      "statement": "Deliver the diagram for the stated intent as an SVG drawing every node of the delivered graph.",
      "constraints": [
        "svg-1-1",
        "content-address-identity"
      ],
      "projections": [
        "svg",
        "graph"
      ],
      "acceptance": [
        "svg-safe",
        "svg-covers-graph"
      ]
    }
  ],
  "prohibitions": [
    {
      "id": "no-active-content",
      "statement": "The SVG may not carry script, event handlers or external references.",
      "constraints": [
        "svg-1-1"
      ],
      "projections": [
        "svg"
      ],
      "acceptance": [
        "svg-safe"
      ]
    }
  ]
}
