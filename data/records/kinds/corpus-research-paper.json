{
  "$schema": "../schema/kind-profile.schema.json",
  "type": "FabricationKindProfile",
  "version": 1,
  "kind": "corpus-research-paper",
  "title": "Research paper grounded in a house corpus",
  "summary": "The full research paper, grounded in a named house corpus (sociology, governance, agentics, philosophy or metaphysics) read through CAIRN record and L-Space reads.",
  "inputSchema": {
    "type": "object",
    "required": [
      "title",
      "thesis",
      "corpus"
    ],
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "subtitle": {
        "type": "string"
      },
      "thesis": {
        "type": "string",
        "minLength": 1,
        "description": "The question or proposition the paper answers."
      },
      "authors": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          }
        }
      },
      "sourceBundle": {
        "type": "object",
        "required": [
          "locator",
          "digest"
        ],
        "additionalProperties": false,
        "description": "A buyer-supplied repository snapshot (data, claims spec, figures, references). Omitted: the fabricator researches and builds its own.",
        "properties": {
          "locator": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^(sha256:[a-f0-9]{64}|ni:///sha-256;[A-Za-z0-9_-]{43})$"
          }
        }
      },
      "license": {
        "type": "string",
        "default": "CC-BY-4.0"
      },
      "language": {
        "type": "string",
        "default": "en-US"
      },
      "keywords": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "corpus": {
        "enum": [
          "sociology",
          "governance",
          "agentics",
          "philosophy",
          "metaphysics"
        ],
        "description": "The named house corpus the paper is grounded in."
      },
      "minimumRecords": {
        "type": "integer",
        "minimum": 1,
        "default": 5,
        "description": "The fewest distinct corpus records the paper must cite."
      }
    }
  },
  "producers": [
    {
      "id": "agent",
      "package": "@red-cup-engineering/agent-harness-computer-system-engineering-services-section",
      "operation": "carrier/agency-carrier",
      "role": "Does the authoring or search the kind needs, under the order, through the agent-harness carrier.",
      "source": "agent-harness"
    },
    {
      "id": "cairn",
      "package": "@red-cup-engineering/knowledge-system-server",
      "operation": "content-reader and search/service (record and L-Space reads)",
      "role": "Reads the named house corpus: the records the paper may cite and be grounded in.",
      "source": "registry"
    },
    {
      "id": "authoring",
      "package": "@red-cup-engineering/research-paper-authoring-service",
      "operation": "planResearchPaperDraft",
      "role": "The thesis-centered section plan the agent writes to.",
      "source": "registry"
    },
    {
      "id": "claims",
      "package": "@red-cup-engineering/research-claim-reproduction-service",
      "operation": "reproduce-paper-claims",
      "role": "Re-derives every stated claim from the supplied data.",
      "source": "registry"
    },
    {
      "id": "figures",
      "package": "@red-cup-engineering/chart-specification-rendering-service",
      "operation": "render-chart-specifications",
      "role": "Renders each Vega-Lite figure specification to deterministic SVG.",
      "source": "registry"
    },
    {
      "id": "references",
      "package": "@red-cup-engineering/csl-yaml-services-section",
      "operation": "project-bibliography-records-as-csl-yaml",
      "role": "Projects bibliography records to CSL YAML for citation resolution.",
      "source": "registry"
    },
    {
      "id": "metadata",
      "package": "@red-cup-engineering/research-release-metadata-service",
      "operation": "project-citation-cff",
      "role": "Projects paper.yaml to CITATION.cff, .zenodo.json, codemeta and ScholarlyArticle JSON-LD.",
      "source": "registry"
    },
    {
      "id": "conformance",
      "package": "rdf-vocabulary-conformance-service",
      "operation": "check-vocabulary-conformance",
      "role": "Checks ontology and record files against their vocabulary.",
      "source": "python"
    },
    {
      "id": "render",
      "package": "@red-cup-engineering/project-document-through-pandoc-service",
      "operation": "render-manuscript",
      "role": "Renders the manuscript to PDF, HTML, DOCX and JATS with a reproducible build receipt.",
      "source": "registry"
    },
    {
      "id": "provenance",
      "package": "@red-cup-engineering/prov-o-provenance-service",
      "operation": "compose-provenance-manifest",
      "role": "Composes the render receipt with the declared people and projects PROV-O.",
      "source": "registry"
    }
  ],
  "steps": [
    {
      "id": "read-corpus",
      "producer": "cairn",
      "summary": "Read the named corpus records the thesis bears on.",
      "consumes": [
        "order"
      ],
      "produces": [
        "corpus-records"
      ],
      "dependsOn": []
    },
    {
      "id": "author-manuscript",
      "producer": "agent",
      "summary": "Write manuscript, claims specification, figure specifications and references to the section plan.",
      "consumes": [
        "order",
        "corpus-records"
      ],
      "produces": [
        "manuscript",
        "claims-spec",
        "figure-specs",
        "bibliography",
        "paper-yaml",
        "corpus-citations"
      ],
      "dependsOn": [
        "read-corpus"
      ]
    },
    {
      "id": "reproduce-claims",
      "producer": "claims",
      "summary": "Re-derive every stated claim from the supplied data.",
      "consumes": [
        "claims-spec"
      ],
      "produces": [
        "claims"
      ],
      "dependsOn": [
        "author-manuscript"
      ]
    },
    {
      "id": "render-figures",
      "producer": "figures",
      "summary": "Render figure specifications to SVG.",
      "consumes": [
        "figure-specs"
      ],
      "produces": [
        "figures"
      ],
      "dependsOn": [
        "author-manuscript"
      ]
    },
    {
      "id": "resolve-references",
      "producer": "references",
      "summary": "Project bibliography records to CSL YAML.",
      "consumes": [
        "bibliography"
      ],
      "produces": [
        "csl-references"
      ],
      "dependsOn": [
        "author-manuscript"
      ]
    },
    {
      "id": "project-metadata",
      "producer": "metadata",
      "summary": "Project release metadata from paper.yaml.",
      "consumes": [
        "paper-yaml"
      ],
      "produces": [
        "release-metadata"
      ],
      "dependsOn": [
        "author-manuscript"
      ]
    },
    {
      "id": "check-ontology",
      "producer": "conformance",
      "summary": "Check ontology and record files for vocabulary conformance.",
      "consumes": [
        "manuscript"
      ],
      "produces": [
        "conformance-report"
      ],
      "dependsOn": [
        "author-manuscript"
      ]
    },
    {
      "id": "render-manuscript",
      "producer": "render",
      "summary": "Render the manuscript to every document medium with its build receipt.",
      "consumes": [
        "manuscript",
        "claims",
        "figures",
        "csl-references",
        "release-metadata"
      ],
      "produces": [
        "pdf",
        "html",
        "docx",
        "jats",
        "render-receipt"
      ],
      "dependsOn": [
        "reproduce-claims",
        "render-figures",
        "resolve-references",
        "project-metadata"
      ]
    },
    {
      "id": "compose-provenance",
      "producer": "provenance",
      "summary": "Compose the render receipt with the declared people as PROV-O.",
      "consumes": [
        "render-receipt"
      ],
      "produces": [
        "provenance"
      ],
      "dependsOn": [
        "render-manuscript",
        "check-ontology"
      ]
    }
  ],
  "deliverables": [
    {
      "projection": "pdf",
      "mediaType": "application/pdf",
      "target": "paper.pdf"
    },
    {
      "projection": "html",
      "mediaType": "text/html",
      "target": "paper.html"
    },
    {
      "projection": "docx",
      "mediaType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "target": "paper.docx"
    },
    {
      "projection": "jats",
      "mediaType": "application/jats+xml",
      "target": "paper.jats.xml"
    },
    {
      "projection": "claims",
      "mediaType": "application/json",
      "target": "claims.json"
    },
    {
      "projection": "provenance",
      "mediaType": "application/ld+json",
      "target": "prov.jsonld"
    },
    {
      "projection": "corpus-citations",
      "mediaType": "application/json",
      "target": "corpus-citations.json"
    }
  ],
  "assays": [
    {
      "id": "claims-reproduce",
      "statement": "Every stated claim re-derives from the supplied data to the delivered claims record.",
      "uses": [
        "@red-cup-engineering/research-claim-reproduction-service"
      ]
    },
    {
      "id": "conformance-passes",
      "statement": "The ontology and record files conform to their vocabulary: the conformance report is clean.",
      "uses": [
        "rdf-vocabulary-conformance-service"
      ]
    },
    {
      "id": "render-receipt-closes",
      "statement": "The render receipt names every delivered document by its ni name and its PROV fragment closes.",
      "uses": [
        "@red-cup-engineering/project-document-through-pandoc-service",
        "@red-cup-engineering/prov-o-provenance-service"
      ]
    },
    {
      "id": "metadata-consistent",
      "statement": "CITATION.cff, .zenodo.json, codemeta.json and the ScholarlyArticle JSON-LD agree with paper.yaml.",
      "uses": [
        "@red-cup-engineering/research-release-metadata-service"
      ]
    },
    {
      "id": "references-resolve",
      "statement": "Every citekey the manuscript cites resolves in the delivered references.",
      "uses": [
        "@red-cup-engineering/csl-yaml-services-section"
      ]
    },
    {
      "id": "corpus-grounded",
      "statement": "Every cited corpus record exists in the named corpus and at least the ordered minimum are cited.",
      "uses": [
        "@red-cup-engineering/knowledge-system-server"
      ]
    }
  ],
  "price": {
    "currency": "USD",
    "basis": "fixed",
    "amount": "$100.00"
  },
  "turnaround": {
    "seconds": 259200,
    "label": "within 72 hours of an activated order"
  },
  "constraints": [
    {
      "id": "content-address-identity",
      "kind": "law",
      "authority": "IETF RFC 6920",
      "revision": "2013",
      "locator": "https://www.rfc-editor.org/rfc/rfc6920",
      "applicability": "Every delivered byte string.",
      "statement": "A delivered artifact is named by the sha-256 ni name of its bytes; equal bytes have equal names, so acceptance is evidence about those bytes alone."
    },
    {
      "id": "claims-are-reproducible",
      "kind": "law",
      "authority": "561 Group research-claim-reproduction-service",
      "revision": "0.1.0",
      "locator": "@red-cup-engineering/research-claim-reproduction-service",
      "applicability": "Every quantitative statement in the paper.",
      "statement": "A quantitative claim is admitted only as the deterministic result of a stated computation over supplied data."
    },
    {
      "id": "prov-o-provenance",
      "kind": "standard",
      "authority": "W3C",
      "revision": "PROV-O Recommendation 2013-04-30",
      "locator": "https://www.w3.org/TR/prov-o/",
      "applicability": "The provenance deliverable.",
      "statement": "Provenance is stated as agents, activities and ni-addressed entities, and every reference closes."
    },
    {
      "id": "jats-document-model",
      "kind": "standard",
      "authority": "NISO",
      "revision": "JATS 1.3 (ANSI/NISO Z39.96-2021)",
      "locator": "https://www.niso.org/publications/z3996-2021-jats",
      "applicability": "The JATS deliverable.",
      "statement": "The JATS deliverable is an article in the NISO JATS model."
    },
    {
      "id": "signcell-acceptance",
      "kind": "standard",
      "authority": "561 Group SignCell",
      "revision": "0.12",
      "locator": "@red-cup-engineering/signcell/cell",
      "applicability": "Acceptance.",
      "statement": "Acceptance is a SignCell cell per assay: subject the artifact ni, predicate the assay id, witnesses the assay evidence."
    }
  ],
  "requirements": [
    {
      "id": "documents-delivered",
      "statement": "Deliver the paper whose title the order states as PDF, HTML, DOCX and JATS from one reproducible render.",
      "constraints": [
        "content-address-identity",
        "jats-document-model"
      ],
      "projections": [
        "pdf",
        "html",
        "docx",
        "jats"
      ],
      "acceptance": [
        "render-receipt-closes",
        "metadata-consistent",
        "references-resolve"
      ]
    },
    {
      "id": "claims-delivered",
      "statement": "Deliver the claims record reproduced from supplied data in support of the thesis the order states.",
      "constraints": [
        "claims-are-reproducible",
        "content-address-identity"
      ],
      "projections": [
        "claims"
      ],
      "acceptance": [
        "claims-reproduce"
      ]
    },
    {
      "id": "provenance-delivered",
      "statement": "Deliver a PROV-O provenance record that closes over the render and conformance.",
      "constraints": [
        "prov-o-provenance",
        "signcell-acceptance"
      ],
      "projections": [
        "provenance"
      ],
      "acceptance": [
        "render-receipt-closes",
        "conformance-passes"
      ]
    },
    {
      "id": "grounded-in-corpus",
      "statement": "Ground the paper in the corpus the order names and deliver the list of corpus records it cites.",
      "constraints": [
        "content-address-identity",
        "signcell-acceptance"
      ],
      "projections": [
        "corpus-citations"
      ],
      "acceptance": [
        "corpus-grounded"
      ]
    }
  ],
  "prohibitions": [
    {
      "id": "no-unreproducible-claim",
      "statement": "No quantitative claim may appear that the claims record does not reproduce.",
      "constraints": [
        "claims-are-reproducible"
      ],
      "projections": [
        "claims",
        "pdf"
      ],
      "acceptance": [
        "claims-reproduce"
      ]
    },
    {
      "id": "no-foreign-record",
      "statement": "No cited corpus record may come from outside the ordered corpus.",
      "constraints": [
        "content-address-identity"
      ],
      "projections": [
        "corpus-citations"
      ],
      "acceptance": [
        "corpus-grounded"
      ]
    }
  ]
}
